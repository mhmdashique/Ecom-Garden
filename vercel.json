{
  "version": 2,
  "build": {
    "env": {
      "VITE_CONFIG_NATIVE_IGNORE_WARNING": "true"
    }
  },
  "builds": [
    {
      "src": "backend/src/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "chunkSizeWarningLimit": 1000
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/package.json"
    }
  ]
}
